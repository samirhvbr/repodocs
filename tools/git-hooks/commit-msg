#!/usr/bin/env bash
# commit-msg — the commit subject must be `X.Y.Z - comentário em português`.
#
# Why here: this is the only moment the message exists and the commit does not.
# It cannot see the remote (that is pre-push's job) and it does not run any
# suite — a hook that makes committing slow becomes a hook people bypass.
#
# Norm: docs/versioning.md · escape hatch: REPODOCS_NO_HOOK=1
set -euo pipefail

if [ "${REPODOCS_NO_HOOK:-0}" = "1" ]; then
  echo "commit-msg: skipped (REPODOCS_NO_HOOK=1)" >&2
  exit 0
fi

msg_file="$1"
# First non-comment, non-empty line = the subject.
subject="$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1 || true)"

die() {
  echo "" >&2
  echo "commit-msg: REJECTED — $1" >&2
  echo "" >&2
  echo "  subject read: ${subject:-(empty)}" >&2
  echo "  required:     X.Y.Z - comentário em português" >&2
  echo "  example:      1.0.0 - estrutura inicial de documentacao" >&2
  echo "" >&2
  echo "  The version comes from version.md and is bumped in this same commit." >&2
  echo "  Rules: docs/versioning.md · bypass: REPODOCS_NO_HOOK=1" >&2
  echo "" >&2
  exit 1
}

[ -n "$subject" ] || die "empty commit message"

# Conventional Commits are forbidden fleet-wide: the version, not a type
# prefix, is what makes `git log` searchable here.
if printf '%s' "$subject" | grep -qiE '^(feat|fix|chore|docs|refactor|test|style|perf|build|ci)(\([^)]*\))?!?:'; then
  die "Conventional Commits prefix is forbidden (feat:/fix:/chore:/...)"
fi

if ! printf '%s' "$subject" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+ - .+'; then
  die "subject does not start with a version followed by ' - ' and a comment"
fi

comment="${subject#* - }"
# A comment must actually describe something. Single vague words are the
# failure mode the norm names explicitly.
if printf '%s' "$comment" | grep -qiE '^(ajuste|ajustes|update|updates|fix|correcao|correção|wip|teste|test|misc|varios|vários)[[:space:]]*\.?$'; then
  die "vague comment ('$comment') — say what changed and why"
fi

if [ "${#comment}" -lt 12 ]; then
  die "comment too short (${#comment} chars, minimum 12) — say what changed and why"
fi

exit 0
